# ==============================================================================
# FinAI Web Platform - Environment Variables Template
# ==============================================================================
# Bu dosya, projeyi yerel veya üretim ortamında çalıştırabilmek için gereken tüm
# ortam değişkenlerinin (environment variables) şablonudur.
#
# KURULUM:
# 1. Bu dosyayı kopyalayarak yerel geliştirme için `.env.local` oluşturun:
#    cp .env.example .env.local
# 2. Değerleri kendi Supabase, Google AI Studio ve VAPID anahtarlarınızla doldurun.
# ==============================================================================

# --- Uygulama Yapılandırması ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Veritabanı ve Kimlik Doğrulama ---
# Supabase Proje Ayarları > API bölümünden temin edilir.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# DİKKAT: Service Role Key sadece sunucu tarafında (Backend / API) kullanılır.
# Asla istemciye (frontend) veya NEXT_PUBLIC_ ile başlayan bir değişkene verilmemelidir!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --- Google Gemini Yapılandırması (FinAI Zekası) ---
# https://aistudio.google.com üzerinden API anahtarı temin edilir.
GEMINI_API_KEY=your-google-gemini-api-key-here

# --- Arka Plan Zamanlanmış Görevleri (Cron Jobs) ---
# Vercel Cron veya curl ile tetiklenen arka plan görevlerini yetkilendiren gizli anahtar.
# Üretimde güçlü, rastgele üretilmiş bir UUID veya token kullanınız (örn: openssl rand -hex 32).
CRON_SECRET=your-secure-cron-secret-token

# --- E-Posta Bildirimleri (Resend API) ---
# Haftalık özet bültenleri ve portföy bildirimleri için kullanılır.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=FinAI <bildirim@finai.net.tr>

# --- Web Push Bildirimleri (VAPID Anahtarları) ---
# Tarayıcı anlık bildirimleri (Push Notifications) için kullanılır.
# Yeni anahtar çifti üretmek için: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_MAILTO=mailto:destek@finai.net.tr
